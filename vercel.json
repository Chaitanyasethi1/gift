{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/box-builder", "destination": "/box-builder.html" },
    { "source": "/custom-box-builder", "destination": "/box-builder.html" },
    { "source": "/certifications", "destination": "/certifications.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/track-order", "destination": "/track-order.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/returns-refunds", "destination": "/returns-refunds.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/cookies", "destination": "/cookies.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
